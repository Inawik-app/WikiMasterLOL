# Copy to .env.local and fill in from the Supabase dashboard (Project Settings > API).
# .env.local is ignored by git: never commit real values.

# Safe in the browser: row level security decides what each player can read.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only, never prefixed with NEXT_PUBLIC_. Needed to open boosters.
# In the dashboard: the "secret" key (or the legacy "service_role" key).
SUPABASE_SERVICE_ROLE_KEY=

# Contact address shown on the legal page (requests about personal data, reports).
NEXT_PUBLIC_CONTACT_EMAIL=
